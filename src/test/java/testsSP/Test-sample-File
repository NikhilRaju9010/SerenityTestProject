// tests/AddToCartTest.java
public class AddToCartTest {

    WebDriver driver;

    @Test
    public void user_should_add_product_to_cart() {

        Actor nikhil = Actor.named("Nikhil");
        nikhil.can(BrowseTheWeb.with(driver));

        nikhil.attemptsTo(
            Open.url("https://example.com"),
            Login.withCredentials("admin", "1234"),
            SearchProduct.forItem("laptop"),
            AddToCart.item()
        );

        nikhil.should(
            seeThat(CartItemVisible.isDisplayed())
        );
    }
}

