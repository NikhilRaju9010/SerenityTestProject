// tasks/AddToCart.java
public class AddToCart implements Task {

    public static AddToCart item() {
        return Tasks.instrumented(AddToCart.class);
    }

    @Override
    public <T extends Actor> void performAs(T actor) {
        actor.attemptsTo(
            Click.on(ProductPage.PRODUCT_ITEM),
            Click.on(ProductPage.ADD_TO_CART)
        );
    }
}

