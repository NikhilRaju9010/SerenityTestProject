// interactions/WaitAndClick.java
public class WaitAndClick implements Interaction {

    private Target target;

    public WaitAndClick(Target target) {
        this.target = target;
    }

    public static WaitAndClick on(Target target) {
        return new WaitAndClick(target);
    }

    @Override
    public <T extends Actor> void performAs(T actor) {
        WaitUntil.the(target, WebElementStateMatchers.isVisible())
                 .forNoMoreThan(10).seconds();

        actor.attemptsTo(
            Click.on(target)
        );
    }
}

