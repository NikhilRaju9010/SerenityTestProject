// tasks/SearchProduct.java
public class SearchProduct implements Task {

    private String product;

    public SearchProduct(String product) {
        this.product = product;
    }

    public static SearchProduct forItem(String product) {
        return Tasks.instrumented(SearchProduct.class, product);
    }

    @Override
    public <T extends Actor> void performAs(T actor) {
        actor.attemptsTo(
            Enter.theValue(product).into(ProductPage.SEARCH_BOX),
            Click.on(ProductPage.SEARCH_BUTTON)
        );
    }
}

