// questions/CartItemVisible.java
public class CartItemVisible implements Question<Boolean> {

    public static CartItemVisible isDisplayed() {
        return new CartItemVisible();
    }

    @Override
    public Boolean answeredBy(Actor actor) {
        return ProductPage.CART_ITEM.resolveFor(actor).isVisible();
    }
}

